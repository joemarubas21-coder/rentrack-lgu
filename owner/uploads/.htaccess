# Prevent execution of any script inside the uploads folder,
# even if a malicious file ever slips past validation.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
AddType text/plain .php .phtml .php3 .php4 .php5
